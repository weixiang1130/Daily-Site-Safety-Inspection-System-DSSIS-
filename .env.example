# 複製成 .env 或直接設為系統環境變數。.env 不會進版控。

# ---- 資料庫 ----
# 開發（預設）：SQL Server LocalDB，不需設定任何變數
# 指定其他 SQL Server：
# MSSQL_SERVER=SRV-DB01
# MSSQL_DATABASE=SafetyOps
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# 使用帳密而非 Windows 驗證時，直接給完整連線字串：
# DATABASE_URL=mssql+pyodbc://user:pw@SRV-DB01/SafetyOps?driver=ODBC+Driver+17+for+SQL+Server

# 無 SQL Server 的環境（例如 Linux 容器快速試跑）：
# DB_BACKEND=sqlite

# ---- 品牌識別 ----
# repo 為公開，程式碼中的預設值一律為中性名稱。
# 實際公司名稱只設定在部署環境，不寫進版控。
# BRAND_NAME=○○營造股份有限公司
# BRAND_SHORT_NAME=○○營造
# BRAND_NAME_EN=
# BRAND_GROUP=
# SYSTEM_NAME=職安填報系統
# WAR_ROOM_NAME=職安戰情室

# ---- 單一主場站模式 ----
# 主場站的工地代碼。設定後「填報頁」的工地選單只列這一個工地
# （兩張建照、同一塊工地，棟別由填報時的「棟別」欄位區分）。
# 過濾發生在填報頁前端（經 /api/branding）；/api/sites 一律回完整清單，
# 缺失清單／儀表板的瀏覽篩選與匯入工具都靠它查工地主檔。
# 未設定或代碼對不上時填報選單退回完整清單。
# PRIMARY_SITE_CODE=SITE-A

# 棟別選項與標籤（code:標籤,…）。標籤值（依序去重）會成為填報頁的
# 棟別選單選項；未設定時前端用預設清單（frontend/common.js 的 BUILDINGS）。
# 與地端 .env.onprem 的同名變數保持一致，牆上與填報的棟別名稱才不會分岔。
# BUILDING_LABELS=SITE-A1:辦公棟,SITE-A2:住宅棟

# ---- 安全性 ----
# session cookie 簽章金鑰，正式環境務必更換
SECRET_KEY=change-me-to-a-long-random-string

# 設備廠商推送資料用的權杖，格式 廠商代碼:權杖，以逗號分隔
INGEST_TOKENS=vendor-a:REPLACE_ME,vendor-b:REPLACE_ME,vendor-c:REPLACE_ME
