# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# 資料庫
*.db
*.db-journal
*.sqlite3
*.mdf
*.ldf

# 使用者上傳內容（照片、簽名、產出的 PDF）—— 含個資，不得進版控
uploads/

# 環境設定
.env
.env.*
!.env.example
!.env.onprem.example
# 工地檢視器的設定檔名（envfile.py 也認得它）——內含真實帳密
連線設定.env

# 去識別化對照表 —— 等同還原金鑰，嚴禁進版控
deid_rules.local.json

# 含公司真實資料的本機主檔（工地名稱、人員名冊等），不進版控。
# 這些資料由匯入工具在執行時送進站台，不隨程式碼發布。
# 2026-09-02 data/ 搬進 backend/data/，規則要跟著搬——舊規則失效時
# git check-ignore backend/data/xxx.local.md 會回 1，敏感檔就等著被 add -A。
*.local.json
*.local.md
backend/data/*.local.*
*.internal
*.internal.*
docs.internal/

# 建置產出
dist/

# 編輯器 / 作業系統
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 公司內部文件（會議紀錄、原始表單範本、掃描件）不進版控
*.docx
*.doc
*.pdf
!docs/**/*.pdf

# Node / Netlify
node_modules/
.netlify/

# 雲端同步進度。屬各機器自己的執行時狀態，不是專案內容
sync_state.json

# 排程執行的記錄檔，各機器自己的執行時產物
logs/
# 雲端呼叫用量與快照指紋：各機器自己的執行時狀態，不是專案內容
cloud_budget.json
wallboard_digest.txt
