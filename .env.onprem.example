# 地端戰情室的連線設定範本。
#
# 複製成 .env.onprem 再填入實際值。.env.onprem 已被 .gitignore 排除，
# 真實主機、帳號與密碼絕不可進版控——本檔只放格式說明與假值。

# --- 門禁即時資料（公司開放的唯讀檢視表）---
ACCESS_DB_HOST=資料庫主機名稱
ACCESS_DB_NAME=資料庫名稱
ACCESS_DB_USER=唯讀帳號
ACCESS_DB_PASS=密碼
ACCESS_DB_VIEW=檢視表名稱
# 用來從 LocationName 篩出本工地。檢視表涵蓋全公司列管工地，
# 不篩會把別的工地人數一起算進來
ACCESS_SITE_LIKE=工地名稱關鍵字
# 每輪間隔秒數，預設 300
ACCESS_INTERVAL=300

# --- 監視器（地端直連；雲端因來源 IP 限制取不到畫面）---
CAM_URL=http://主機:埠
CAM_USER=帳號
CAM_PASS=密碼
# 要顯示的頻道，逗號分隔
CAM_CHANNELS=4,7

# --- 微型氣象站 ---
WEATHER_API_URL=http://主機:埠
WEATHER_API_USER=帳號
WEATHER_API_PASS=密碼
# 測站 mac 對應本系統工地代碼的 JSON。未列出的測站仍會收，但對應不到工地
WEATHER_SITE_MAP={"測站MAC":"BD04"}
# 每輪間隔秒數，預設 900
WEATHER_INTERVAL=900

# --- 戰情室主場站 ---
# 環境與進出場人次以這個工地為主；缺失統計仍涵蓋全部工地。
# 填報頁的工地選單也只列這個工地（兩張建照、同一塊工地，棟別由填報時
# 的「棟別」欄位區分）——過濾在填報頁前端做，/api/sites 仍回完整清單
PRIMARY_SITE_CODE=BD04

# 列控表 site_code 對應的棟別標籤。主場站的兩張建照各自匯入列控表，
# 牆上的重點工項與進度卡片用這個對應顯示棟別；標籤值同時成為填報頁的
# 棟別選單選項（經 /api/branding 的 buildings）。與雲端 Netlify 環境變數的
# 同名設定保持一致，牆上與填報的棟別名稱才不會分岔。
# 未設定時牆上退回從工地名稱的「-」後綴切、填報選單用前端預設清單。
BUILDING_LABELS=BD04:辦公棟,BD05:住宅棟

# --- 從雲端填報系統同步表單 ---
# 表單仍留在雲端讓工地手機填報，戰情室只把資料抓回地端呈現
CLOUD_API_URL=https://你的站台.netlify.app
CLOUD_SYNC_TOKEN=與站台 SITE_AGENT_TOKEN 相同的權杖
# 每輪間隔秒數。這個值直接決定雲端的函式呼叫次數，是控制額度的主要旋鈕：
#   300   （5 分鐘） 約 8,640 次／月
#   900   （15 分鐘）約 2,880 次／月
#   43200 （12 小時）約 60 次／月
# 工地填報通常一天幾次、多在收工前，牆上不需要分鐘級的即時性。
# 代價是新填的表最久要等一輪才會出現；臨時要看可手動跑一次不帶 --loop。
SYNC_INTERVAL=43200

# --- 工地看板（推快照到雲端）——備援，預設關閉 ---
# 工地看儀表板的正規做法是「工地檢視器」安裝包直連中央資料庫
# （見 docs/工地檢視器.md），不經雲端。只有工地連不到中央資料庫、
# 又暫時打不通網路時，才開啟這條備援：由地端主機把整份儀表板推到
# 雲端存成快照，工地電腦開網址唯讀顯示：
#     https://你的站台/static/dashboard.html?k=<雲端的 WALL_TOKEN>
# 站台與權杖沿用上面的 CLOUD_API_URL / CLOUD_SYNC_TOKEN，不另外設。
WALL_ENABLED=false
#
# 快照涵蓋幾天的統計。工地電腦上的下拉選單在看板模式會隱藏，
# 因此範圍在這裡就決定了。
WALL_DAYS=30
# 只看單一工地時填其 id；留空＝全部工地
WALL_SITE_ID=
# 每輪間隔秒數。900（15 分）與前端輪詢、雲端快取三者對齊——三個數字
# 不一致時，多出來的讀取都是對同一份內容重複付費。
# 注意：這只寫 Blob，不會觸發重新部署——每 5 分鐘 deploy 一次會在三天內
# 燒光免費的 300 分鐘建置額度。
WALL_INTERVAL=900
# 推送時段（24 小時制）。牆前沒有人的時間推上去，是把額度花在沒人看的
# 畫面上；夜間與假日佔掉一天的四成以上。
WALL_HOURS=6-20

# --- 雲端呼叫的每日硬上限（保護機制）---
# 不論上游怎麼壞，這台機器每天最多只會打這麼多次雲端。
# 正常用量：中央主機約 60 次／日、工地檢視器約 2 次／日。
# 2026-09-03 免費額度曾被「重啟即同步」的故障迴圈燒光（約 20 萬次／月），
# 這道上限就是為了讓同樣的事不可能再發生。詳見 collectors/cloud_budget.py。
CLOUD_DAILY_BUDGET=300

# --- FinOps 工程進度（唯讀）---
# 財務進度（以金額衡量），供儀表板「實際 vs 預估」對照
FINOPS_SERVER=主機\執行個體,1433
FINOPS_USER=唯讀帳號
FINOPS_PWD=密碼（自行填入，勿交由工具代填）
# 專案代碼對應工地代碼的 JSON
FINOPS_PROJECT_MAP={"專案代碼":"BD04"}
# 每輪間隔秒數，預設 43200（月結資料，再頻繁也不會變）
FINOPS_INTERVAL=43200

# --- 人臉辨識裝置的彙總人次 ---
# 只取每個門的進出／在場計數，不呼叫任何回傳姓名或人臉的端點
FACE_URL=http://主機
# 門名關鍵字→工地代碼；門名分不出棟別時用 {"*":"BD04"} 全部加總到一處
FACE_SITE_MAP={"*":"BD04"}
FACE_INTERVAL=300

# --- session 簽章金鑰 ---
# 務必設定一組長隨機字串（例：python -c "import secrets;print(secrets.token_hex(32))"）。
# 未設定時每次啟動用隨機金鑰，伺服器一重啟所有登入就失效。
SECRET_KEY=請填入長隨機字串
